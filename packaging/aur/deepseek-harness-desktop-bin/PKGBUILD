pkgname=deepseek-harness-desktop-bin
pkgver=0.1.2.rc.1.build.12
pkgrel=1
pkgdesc="Desktop installers for DeepSeek Harness. Everything is a plugin."
arch=('x86_64' 'aarch64')
url="https://github.com/LodeKennes/deepseek-harness-desktop"
license=('MIT')
depends=('gtk3' 'libnotify' 'nss' 'libxss' 'libxtst' 'xdg-utils' 'at-spi2-core' 'libsecret')
provides=('deepseek-harness-desktop')
conflicts=('deepseek-harness-desktop')
options=('!strip')
source_x86_64=("DeepSeek-Harness-0.1.2-rc.1-build-12-linux-x64.pkg.tar.zst::https://github.com/LodeKennes/deepseek-harness-desktop/releases/download/desktop-v0.1.2-rc.1-build-12/DeepSeek-Harness-0.1.2-rc.1-build-12-linux-x64.pkg.tar.zst")
source_aarch64=("DeepSeek-Harness-0.1.2-rc.1-build-12-linux-aarch64.pkg.tar.zst::https://github.com/LodeKennes/deepseek-harness-desktop/releases/download/desktop-v0.1.2-rc.1-build-12/DeepSeek-Harness-0.1.2-rc.1-build-12-linux-aarch64.pkg.tar.zst")
sha256sums_x86_64=('b3ea3f2bc14db93bacc5bb388d912381a7fb279b9aa7c20b11f4a1e46fa56618')
