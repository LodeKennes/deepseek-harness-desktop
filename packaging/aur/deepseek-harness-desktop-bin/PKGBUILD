pkgname=deepseek-harness-desktop-bin
pkgver=0.1.1.rc.1.build.11
pkgrel=1
pkgdesc="Desktop installers for DeepSeek Harness. Everything is a plugin."
arch=('x86_64' 'aarch64')
url="https://github.com/LodeKennes/deepseek-harness-desktop"
license=('MIT')
depends=('gtk3' 'libnotify' 'nss' 'libxss' 'libxtst' 'xdg-utils' 'at-spi2-core' 'libsecret')
provides=('deepseek-harness-desktop')
conflicts=('deepseek-harness-desktop')
options=('!strip')
source_x86_64=("DeepSeek-Harness-0.1.1-rc.1-build-11-linux-x64.pkg.tar.zst::https://github.com/LodeKennes/deepseek-harness-desktop/releases/download/desktop-v0.1.1-rc.1-build-11/DeepSeek-Harness-0.1.1-rc.1-build-11-linux-x64.pkg.tar.zst")
source_aarch64=("DeepSeek-Harness-0.1.1-rc.1-build-11-linux-aarch64.pkg.tar.zst::https://github.com/LodeKennes/deepseek-harness-desktop/releases/download/desktop-v0.1.1-rc.1-build-11/DeepSeek-Harness-0.1.1-rc.1-build-11-linux-aarch64.pkg.tar.zst")
sha256sums_x86_64=('c0b7795271bdcc6630714480c744e234cecf66062eb65383bb76ab4fcec42f0e')
